<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.9" />
    <ProjectReference Include="..\..\src\OpenVerse.Common\OpenVerse.Common.csproj" />
    <ProjectReference Include="..\..\src\OpenVerse.Api\OpenVerse.Api.csproj" />
    <ProjectReference Include="..\..\src\OpenVerse.Battle\OpenVerse.Battle.csproj" />
    <ProjectReference Include="..\..\src\OpenVerse.Engine\OpenVerse.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\src\OpenVerse.Api\stubs\**\*.json" Link="stubs\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="assets\**\*" Link="assets\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- OpenVerse.Decker is a net10.0-windows/WPF project and can't be ProjectReference'd from this
         net10.0 test project - these three files have no WPF/Windows dependency at all, so compile
         the same source directly instead of duplicating it -->
    <Compile Include="..\..\tools\OpenVerse.Decker\Data\TextLoader.cs" Link="Decker\TextLoader.cs" />
    <Compile Include="..\..\tools\OpenVerse.Decker\Data\CardTextMarkup.cs" Link="Decker\CardTextMarkup.cs" />
    <Compile Include="..\..\tools\OpenVerse.Decker\Data\CardTextComposer.cs" Link="Decker\CardTextComposer.cs" />
    <Compile Include="..\..\tools\OpenVerse.Decker\Data\StatsLoader.cs" Link="Decker\StatsLoader.cs" />
    <Compile Include="..\..\tools\OpenVerse.Decker\Data\CardFilterLoader.cs" Link="Decker\CardFilterLoader.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\tools\OpenVerse.Decker\Resources\unlimited_cards.json"
                       Link="Decker\Resources\unlimited_cards.json"
                       LogicalName="OpenVerse.Decker.Resources.unlimited_cards.json" />
    <EmbeddedResource Include="..\..\tools\OpenVerse.Decker\Resources\resurgent_cards.json"
                       Link="Decker\Resources\resurgent_cards.json"
                       LogicalName="OpenVerse.Decker.Resources.resurgent_cards.json" />
  </ItemGroup>

  <Import Project="..\..\src\EngineHost.targets" />

</Project>