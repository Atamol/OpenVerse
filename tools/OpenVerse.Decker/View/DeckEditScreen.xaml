<UserControl x:Class="OpenVerse.Decker.View.DeckEditScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OpenVerse.Decker.View">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!--left: deck info -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        Margin="0,0,0,8">
                <TextBox x:Name="DeckNameBox"
                         Width="220"
                         Padding="4"
                         VerticalContentAlignment="Center"/>
                <ComboBox x:Name="ClassIdComboBox"
                          Width="120"
                          Margin="8,0,0,0"
                          Padding="6,4"
                          DisplayMemberPath="Value"
                          SelectedValuePath="Key"/>
                <Button Content="{DynamicResource SaveButton}"
                        Margin="8,0,0,0"
                        Padding="10,4"
                        Click="SaveButton_Click"/>
                <Button Content="{DynamicResource CancelButton}"
                        Margin="8,0,0,0"
                        Padding="10,4"
                        Click="CancelButton_Click"/>
                <Border Margin="12,0,0,0"
                        Padding="8,3"
                        CornerRadius="3"
                        Background="#1E1E22"
                        BorderBrush="#3A3A42"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding TotalCardCount, StringFormat={}{0}/40}"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="#E8E8EC"/>
                </Border>
            </StackPanel>

            <ItemsControl x:Name="DeckGrid"
                          Grid.Row="1"
                          ItemsSource="{Binding DeckCards}"
                          ScrollViewer.CanContentScroll="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer CanContentScroll="True"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <local:VirtualizingWrapPanel ItemWidth="116"
                                                     ItemHeight="156"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <local:CardViewUserControl/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- right: card list / search -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBox x:Name="SearchBox"
                     Grid.Row="0"
                     Padding="6,4"
                     Margin="0,0,0,8"
                     TextChanged="SearchBox_TextChanged"/>

            <!-- cost/type filter buttons are added at runtime -->
            <DockPanel Grid.Row="1"
                       Margin="0,0,0,8"
                       LastChildFill="True"
                       x:Name="FilterButtonPanel">
                <Button Content="{DynamicResource ClearFiltersButton}"
                        Margin="8,0,0,4"
                        Padding="8,2"
                        Click="ClearFilters_Click"
                        DockPanel.Dock="Right"/>
                <StackPanel Orientation="Vertical"
                            DockPanel.Dock="Left">
                    <WrapPanel x:Name="CostFilterPanel"/>
                    <WrapPanel x:Name="TypeFilterPanel"
                               Margin="0,4,0,0"/>
                    <!--for card classification like unlimited or resurgent-->
                    <WrapPanel x:Name="SpecialFilterPanel"
                               Margin="0,4,0,0"/>
                    <WrapPanel x:Name="ClassFilterPanel"
                               Margin="0,4,0,0"/>
                    <WrapPanel x:Name="RarityFilterPanel"
                               Margin="0,4,0,0"/>
                    <!--keyword and tribe hold too many children for a flat row, so each collapses
                        behind one button that opens a popup list (DeckEditScreen.xaml.cs)-->
                    <WrapPanel x:Name="ExpandableFilterPanel"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>
            <ItemsControl x:Name="CandidateGrid"
                          Grid.Row="2"
                          ItemsSource="{Binding CandidateCards}"
                          ScrollViewer.CanContentScroll="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer CanContentScroll="True"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <local:VirtualizingWrapPanel ItemWidth="116"
                                                     ItemHeight="156"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <local:CardViewUserControl/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Grid>
</UserControl>
