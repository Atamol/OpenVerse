<UserControl x:Class="OpenVerse.Decker.View.DeckEditScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OpenVerse.Decker.View">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!--left: deck info -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <WrapPanel Grid.Row="0"
                       Orientation="Horizontal"
                       Margin="0,0,0,8">
                <TextBox x:Name="DeckNameBox"
                         Width="220"
                         Padding="4"
                         VerticalContentAlignment="Center"/>
                <ComboBox x:Name="ClassIdComboBox"
                          Width="120"
                          Margin="8,0,0,0"
                          Padding="6,4"
                          DisplayMemberPath="Value"
                          SelectedValuePath="Key"/>
                <Button Content="{DynamicResource SaveButton}"
                        Margin="8,0,0,0"
                        Padding="10,4"
                        Click="SaveButton_Click"/>
                <Button Content="{DynamicResource CancelButton}"
                        Margin="8,0,0,0"
                        Padding="10,4"
                        Click="CancelButton_Click"/>
                <Border Margin="12,0,0,0"
                        Padding="8,3"
                        CornerRadius="3"
                        Background="#1E1E22"
                        BorderBrush="#3A3A42"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding TotalCardCount, StringFormat={}{0}/40}"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="#E8E8EC"/>
                </Border>
            </WrapPanel>

            <ItemsControl x:Name="DeckGrid"
                          Grid.Row="1"
                          ItemsSource="{Binding DeckCards}"
                          ScrollViewer.CanContentScroll="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer CanContentScroll="True"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <local:VirtualizingWrapPanel ItemWidth="116"
                                                     ItemHeight="156"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <local:CardViewUserControl/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- right: card list and filters -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="White"
                        BorderBrush="#ABADB3"
                        BorderThickness="1"
                        Padding="6,3">
                    <DockPanel>
                        <Path DockPanel.Dock="Left"
                              Width="15"
                              Height="15"
                              Margin="0,0,6,0"
                              VerticalAlignment="Center"
                              Stretch="Uniform"
                              Fill="#5A5A5A"
                              Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"/>
                        <TextBox x:Name="SearchBox"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 VerticalContentAlignment="Center"
                                 TextChanged="SearchBox_TextChanged"
                                 GotKeyboardFocus="SearchBox_GotKeyboardFocus"
                                 PreviewMouseLeftButtonDown="SearchBox_PreviewMouseLeftButtonDown"/>
                    </DockPanel>
                </Border>

                <Button x:Name="SearchClearButton"
                        Grid.Column="1"
                        Content="&#x00D7;"
                        FontSize="15"
                        Margin="4,0,0,0"
                        Padding="8,0"
                        Visibility="Hidden"
                        Click="SearchClear_Click"/>
            </Grid>

            <!-- cost/type filter buttons are added at runtime -->
            <DockPanel Grid.Row="1"
                       Margin="0,0,0,8"
                       LastChildFill="True"
                       x:Name="FilterButtonPanel">
                <Button Content="{DynamicResource ClearFiltersButton}"
                        Margin="8,0,0,4"
                        Padding="8,2"
                        Click="ClearFilters_Click"
                        DockPanel.Dock="Right"/>
                <StackPanel Orientation="Vertical"
                            DockPanel.Dock="Left">
                    <WrapPanel x:Name="CostFilterPanel"/>
                    <WrapPanel x:Name="TypeFilterPanel"
                               Margin="0,4,0,0"/>
                    <!--for card classification like unlimited or resurgent-->
                    <WrapPanel x:Name="SpecialFilterPanel"
                               Margin="0,4,0,0"/>
                    <WrapPanel x:Name="ClassFilterPanel"
                               Margin="0,4,0,0"/>
                    <WrapPanel x:Name="RarityFilterPanel"
                               Margin="0,4,0,0"/>
                    <!--keyword and tribe hold too many children for a flat row, so each collapses
                        behind one button that opens a popup list (DeckEditScreen.xaml.cs)-->
                    <WrapPanel x:Name="ExpandableFilterPanel"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>
            <ItemsControl x:Name="CandidateGrid"
                          Grid.Row="2"
                          ItemsSource="{Binding CandidateCards}"
                          ScrollViewer.CanContentScroll="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer CanContentScroll="True"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <local:VirtualizingWrapPanel ItemWidth="116"
                                                     ItemHeight="156"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <local:CardViewUserControl/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Grid>
</UserControl>
