<UserControl x:Class="OpenVerse.Decker.View.DeckEditScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!--left: deck info -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        Margin="0,0,0,8">
                <TextBox x:Name="DeckNameBox"
                         Width="220"
                         Padding="4"
                         VerticalContentAlignment="Center"/>
                <ComboBox x:Name="ClassIdComboBox"
                          Width="120"
                          Margin="8,0,0,0"
                          Padding="6,4"
                          DisplayMemberPath="Value"
                          SelectedValuePath="Key"/>
                <Button Content="{DynamicResource SaveButton}"
                        Margin="8,0,0,0"
                        Padding="10,4"
                        Click="SaveButton_Click"/>
                <Button Content="{DynamicResource CancelButton}"
                        Margin="8,0,0,0"
                        Padding="10,4"
                        Click="CancelButton_Click"/>
            </StackPanel>

            <!-- ListView+GridView instead of a per-row Grid: GridView keeps every row's columns
                 aligned to the same boundaries, which a Grid inside an ItemsControl's DataTemplate
                 can't do (each row would size its own columns independently) -->
            <ListView Grid.Row="1"
                      ItemsSource="{Binding DeckCards}"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment"
                                Value="Stretch"/>
                        <EventSetter Event="MouseLeftButtonDown"
                                     Handler="Row_MouseLeftButtonDown"/>
                        <EventSetter Event="MouseLeftButtonUp"
                                     Handler="DeckCardRow_MouseLeftButtonUp"/>
                        <EventSetter Event="MouseRightButtonUp"
                                     Handler="DeckCardRow_MouseRightButtonUp"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="40"
                                        DisplayMemberBinding="{Binding TypeAbbreviation}"/>
                        <GridViewColumn Width="180">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CardName}"
                                               TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="40"
                                        DisplayMemberBinding="{Binding Cost}"/>
                        <GridViewColumn Width="35">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Power}"
                                               Visibility="{Binding StatsVisibility}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="20">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="/"
                                               Visibility="{Binding StatsVisibility}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="35">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Life}"
                                               Visibility="{Binding StatsVisibility}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="55">
                            <!-- header shows the deck's current total COPY count (not distinct card
                                 count) out of the 40-card target ("23/40") - TotalCardCount is
                                 summed from DeckCards itself (DeckEditScreen.xaml.cs), so it only
                                 ever reflects what this list is actually showing -->
                            <GridViewColumn.Header>
                                <TextBlock Text="{Binding TotalCardCount, StringFormat={}{0}/40}"/>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Count, StringFormat=x{0}}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>

        <!-- right: card list / search -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBox x:Name="SearchBox"
                     Grid.Row="0"
                     Padding="6,4"
                     Margin="0,0,0,8"
                     TextChanged="SearchBox_TextChanged"/>

            <!-- cost/type filter buttons are added at runtime (DeckEditScreen.xaml.cs,
                 BuildFilterButtons) - one ToggleButton per bucket, multi-select, AND'd together
                 with the search text and with each other in BuildFilters() -->
            <DockPanel Grid.Row="1"
                       Margin="0,0,0,8"
                       LastChildFill="True"
                       x:Name="FilterButtonPanel">
                <Button Content="{DynamicResource ClearFiltersButton}"
                        Margin="8,0,0,4"
                        Padding="8,2"
                        Click="ClearFilters_Click"
                        DockPanel.Dock="Right"/>
                <StackPanel Orientation="Vertical"
                            DockPanel.Dock="Left">
                    <WrapPanel x:Name="CostFilterPanel"/>
                    <WrapPanel x:Name="TypeFilterPanel"
                               Margin="0,4,0,0"/>
                    <!--for card classification like unlimited or resurgent-->
                    <WrapPanel x:Name="SpecialFilterPanel"
                               Margin="0,4,0,0"/>
                    <WrapPanel x:Name="ClassFilterPanel"
                               Margin="0,4,0,0"/>
                    <WrapPanel x:Name="RarityFilterPanel"
                               Margin="0,4,0,0"/>
                    <!--keyword and tribe hold too many children for a flat row, so each collapses
                        behind one button that opens a popup list (DeckEditScreen.xaml.cs)-->
                    <WrapPanel x:Name="ExpandableFilterPanel"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>
            <!-- ListView+GridView here too, for the same column-alignment reason as the left list -->
            <ListView Grid.Row="2"
                      ItemsSource="{Binding CandidateCards}"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment"
                                Value="Stretch"/>
                        <EventSetter Event="MouseLeftButtonDown"
                                     Handler="Row_MouseLeftButtonDown"/>
                        <EventSetter Event="MouseLeftButtonUp"
                                     Handler="CandidateRow_MouseLeftButtonUp"/>
                        <EventSetter Event="MouseRightButtonUp"
                                     Handler="CandidateRow_MouseRightButtonUp"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="40"
                                        DisplayMemberBinding="{Binding TypeAbbreviation}"/>
                        <GridViewColumn Width="220">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CardName}"
                                               TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="40"
                                        DisplayMemberBinding="{Binding Cost}"/>
                        <GridViewColumn Width="35">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Power}"
                                               Visibility="{Binding StatsVisibility}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="20">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="/"
                                               Visibility="{Binding StatsVisibility}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="35">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Life}"
                                               Visibility="{Binding StatsVisibility}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>
    </Grid>
</UserControl>
