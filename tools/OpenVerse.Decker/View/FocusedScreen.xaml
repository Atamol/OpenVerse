<UserControl x:Class="OpenVerse.Decker.View.FocusedScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed">
    <Grid Background="#88000000"
          MouseLeftButtonDown="Shade_MouseLeftButtonDown"
          MouseLeftButtonUp="Shade_MouseLeftButtonUp">
        <Border x:Name="ContentBorder"
                Background="White"
                BorderBrush="Gray"
                BorderThickness="1"
                CornerRadius="4"
                Padding="16"
                MaxWidth="900"
                MaxHeight="650"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MouseLeftButtonDown="ContentBorder_MouseLeftButtonDown"
                MouseLeftButtonUp="ContentBorder_MouseLeftButtonUp">
            <ContentControl x:Name="ContentHost"/>
        </Border>
    </Grid>
</UserControl>
