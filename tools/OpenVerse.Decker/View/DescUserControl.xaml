<UserControl x:Class="OpenVerse.Decker.View.DescUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <StackPanel Width="380">
            <!-- title row: type | name (bold here) | cost | power | / | life - power//life
                 collapse together when this card isn't a Follower (Power/Life == -1) -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TypeText"
                           Grid.Column="0"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="NameText"
                           Grid.Column="1"
                           FontWeight="Bold"
                           FontSize="16"
                           TextWrapping="Wrap"
                           Margin="8,0,0,0"/>
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal">
                    <TextBlock x:Name="CostText"
                               VerticalAlignment="Center"
                               Margin="8,0,10,0"/>
                    <TextBlock x:Name="PowerText"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="SlashText"
                               VerticalAlignment="Center"
                               Text="/"/>
                    <TextBlock x:Name="LifeText"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          MaxHeight="500">
                <TextBlock x:Name="DescText"
                           TextWrapping="Wrap"/>
            </ScrollViewer>
        </StackPanel>

        <Canvas ClipToBounds="False">
            <Border x:Name="AdditionalBorder"
                    Visibility="Collapsed"
                    Canvas.Left="396"
                    Canvas.Top="0"
                    Width="380"
                    Background="White"
                    BorderBrush="Gray"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource DescAdditionalHeader}"
                               FontWeight="Bold"
                               FontSize="16"
                               Margin="0,0,0,8"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  MaxHeight="500">
                        <TextBlock x:Name="AdditionalText"
                                   TextWrapping="Wrap"/>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</UserControl>
