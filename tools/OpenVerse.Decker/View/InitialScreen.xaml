<UserControl x:Class="OpenVerse.Decker.View.InitialScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="24"
            MaxWidth="400"
            HorizontalAlignment="Left">
        <TextBlock Text="{DynamicResource InitialHeader}"
                FontSize="18"
                FontWeight="Bold"
                Margin="0,0,0,16"/>
        <ComboBox x:Name="LangComboBox"
                Padding="8,4"/>
        <TextBlock x:Name="ErrorText"
                Foreground="Red"
                Margin="0,12,0,0"
                TextWrapping="Wrap"/>
        <Button x:Name="RunButton"
                Content="{DynamicResource RunButton}"
                Margin="0,16,0,0"
                Padding="12,6"
                HorizontalAlignment="Left"
                Click="RunButton_Click"/>
    </StackPanel>
</UserControl>
